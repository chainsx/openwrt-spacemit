diff -Nuar -r --no-dereference a/drivers/usb/dwc3/core.c b/drivers/usb/dwc3/core.c
--- a/drivers/usb/dwc3/core.c	2024-11-22 22:38:37.000000000 +0800
+++ b/drivers/usb/dwc3/core.c	2025-05-18 01:44:47.457667985 +0800
@@ -1972,6 +1972,17 @@
 		ret = dma_set_mask_and_coherent(dwc->sysdev, DMA_BIT_MASK(64));
 		if (ret)
 			goto err_disable_clks;
+	} else if(!dwc->sysdev_is_parent &&
+		IS_ENABLED(CONFIG_SOC_SPACEMIT_K1PRO)) {
+		ret = dma_set_mask_and_coherent(dwc->sysdev, DMA_BIT_MASK(40));
+		if (ret)
+			goto err_disable_clks;
+	}
+
+	if (IS_ENABLED(CONFIG_SOC_SPACEMIT_K1X)) {
+		ret = dma_set_mask_and_coherent(dwc->sysdev, DMA_BIT_MASK(32));
+		if (ret)
+			goto err_disable_clks;
 	}
 
 	spin_lock_init(&dwc->lock);
