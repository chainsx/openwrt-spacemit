diff -Nuar -r --no-dereference a/drivers/clocksource/dw_apb_timer.c b/drivers/clocksource/dw_apb_timer.c
--- a/drivers/clocksource/dw_apb_timer.c	2024-11-22 22:38:37.000000000 +0800
+++ b/drivers/clocksource/dw_apb_timer.c	2025-05-18 01:44:34.989652522 +0800
@@ -34,6 +34,8 @@
 #define APBTMR_CONTROL_MODE_PERIODIC	(1 << 1)
 #define APBTMR_CONTROL_INT		(1 << 2)
 
+static raw_spinlock_t dw_apb_timer_lock;
+
 static inline struct dw_apb_clock_event_device *
 ced_to_dw_apb_ced(struct clock_event_device *evt)
 {
@@ -102,8 +104,10 @@
 		return IRQ_NONE;
 	}
 
+	raw_spin_lock(&dw_ced->timer_lock);
 	if (dw_ced->eoi)
 		dw_ced->eoi(&dw_ced->timer);
