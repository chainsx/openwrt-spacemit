diff -Nuar -r --no-dereference a/drivers/usb/host/xhci.c b/drivers/usb/host/xhci.c
--- a/drivers/usb/host/xhci.c	2024-11-22 22:38:37.000000000 +0800
+++ b/drivers/usb/host/xhci.c	2025-05-18 01:44:47.579668135 +0800
@@ -5239,6 +5239,10 @@
 			!dma_set_mask(dev, DMA_BIT_MASK(64))) {
 		xhci_dbg(xhci, "Enabling 64-bit DMA addresses.\n");
 		dma_set_coherent_mask(dev, DMA_BIT_MASK(64));
+	} else if (IS_ENABLED(CONFIG_SOC_SPACEMIT_K1PRO) &&
+			!dma_set_mask(dev, DMA_BIT_MASK(40))) {
+		xhci_dbg(xhci, "Force Enabling 40-bit DMA addresses.\n");
+		dma_set_coherent_mask(dev, DMA_BIT_MASK(40));
 	} else {
 		/*
 		 * This is to avoid error in cases where a 32-bit USB
@@ -5251,6 +5255,12 @@
 		dma_set_coherent_mask(dev, DMA_BIT_MASK(32));
 	}
 
+	if (IS_ENABLED(CONFIG_SOC_SPACEMIT_K1X) &&
+			!dma_set_mask(dev, DMA_BIT_MASK(32))) {
+		dma_set_coherent_mask(dev, DMA_BIT_MASK(32));
+		xhci_dbg(xhci, "Force Enabling 32-bit DMA addresses.\n");
+	}
+
 	xhci_dbg(xhci, "Calling HCD init\n");
 	/* Initialize HCD and host controller data structures. */
 	retval = xhci_init(hcd);
